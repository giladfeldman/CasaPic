{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CasaPic",
  "version": "0.1.0",
  "identifier": "org.casapic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CasaPic",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#F2EFE6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: casapic: http://casapic.localhost; connect-src 'self' ipc: http://ipc.localhost casapic: http://casapic.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
